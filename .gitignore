# ==============================================================================
# TechBridge Root .gitignore
# Prevents committing dependencies, build artifacts, sensitive secrets, & IDE files
# ==============================================================================

# ------------------------------------------------------------------------------
# Sensitive Information, Credentials & Local Environment Files
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Local property overrides containing secrets
application-local.properties
application.properties.local
*-local.properties
*.local.properties
credentials.json
*.pem
*.key
*.cert
*.pfx
*.p12

# ------------------------------------------------------------------------------
# Backend: Java / Spring Boot / Maven Build Outputs
# ------------------------------------------------------------------------------
target/
**/target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar
techBridge.zip
.mvn/wrapper/maven-wrapper.jar
**/maven-wrapper.jar

# ------------------------------------------------------------------------------
# Frontend: Node.js / Vite / React Build Outputs
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
build/
**/build/
.vite/
**/.vite/
.eslintcache
.oxlintcache

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# IDEs, Editors, & Tooling Configuration
# ------------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# IntelliJ IDEA / WebStorm
.idea/
**/.idea/
*.iws
*.iml
*.ipr
out/
**/out/

# Eclipse / STS (Spring Tool Suite)
.apt_generated
.classpath
**/.classpath
.factorypath
**/.factorypath
.project
**/.project
.settings/
**/.settings/
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/nbdist/
/.nb-gradle/

# ------------------------------------------------------------------------------
# OS & System Generated Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
